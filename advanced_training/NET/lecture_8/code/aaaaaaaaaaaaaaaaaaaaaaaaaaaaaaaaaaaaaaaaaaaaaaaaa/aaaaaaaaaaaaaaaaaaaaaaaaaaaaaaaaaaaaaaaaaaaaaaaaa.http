@baseUrl = http://localhost:5010

### Get all products
GET {{baseUrl}}/api/products
Accept: application/json

### Get an existing product
GET {{baseUrl}}/api/products/1
Accept: application/json

### Get a product that does not exist (404)
GET {{baseUrl}}/api/products/999
Accept: application/json

### Create a product (201, with Location header)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Pencil",
  "description": "A wooden HB pencil."
}

### Submit an invalid product (400 validation response)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": ""
}

### Replace an existing product
PUT {{baseUrl}}/api/products/1
Content-Type: application/json

{
  "name": "Notebook",
  "description": "An updated product description."
}

### Update a product that does not exist (404)
PUT {{baseUrl}}/api/products/999
Content-Type: application/json

{
  "name": "Missing product",
  "description": "This request should return 404."
}

### Delete an existing product (204)
DELETE {{baseUrl}}/api/products/2

### Delete a product that does not exist (404)
DELETE {{baseUrl}}/api/products/999

### Get all employees
GET {{baseUrl}}/api/employee
Accept: application/json

### Get an existing employee
GET {{baseUrl}}/api/employee/1
Accept: application/json

### Get an employee that does not exist (404)
GET {{baseUrl}}/api/employee/999
Accept: application/json

### Create an employee (201, with Location header)
POST {{baseUrl}}/api/employee
Content-Type: application/json

{
  "id": 3,
  "name": "Taylor Kim",
  "department": "Design",
  "salary": 78000,
  "isActive": true
}

### Reject an employee with a duplicate ID (409)
POST {{baseUrl}}/api/employee
Content-Type: application/json

{
  "id": 1,
  "name": "Duplicate ID",
  "department": "Design",
  "salary": 78000,
  "isActive": true
}

### Update an existing employee
PUT {{baseUrl}}/api/employee/1
Content-Type: application/json

{
  "id": 1,
  "name": "Alex Morgan",
  "department": "Product Engineering",
  "salary": 90000,
  "isActive": true
}

### Update a missing employee (404)
PUT {{baseUrl}}/api/employee/999
Content-Type: application/json

{
  "id": 999,
  "name": "Missing Employee",
  "department": "Design",
  "salary": 78000,
  "isActive": true
}

### Delete an existing employee (204)
DELETE {{baseUrl}}/api/employee/2

### Delete a missing employee (404)
DELETE {{baseUrl}}/api/employee/999
