@page
@model ElectricityBillModel
@{
    ViewData["Title"] = "Electricity Bill";
}

<h1>Electricity Bill Calculator</h1>
<p class="text-muted">Rates: first 100 units ₹2/unit, next 100 units ₹3/unit, above 200 units ₹5/unit.</p>

<form method="post" class="col-md-4">
    <div class="mb-2">
        <label asp-for="CustomerName" class="form-label">Customer Name</label>
        <input asp-for="CustomerName" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="MeterNumber" class="form-label">Meter Number</label>
        <input asp-for="MeterNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="UnitsConsumed" class="form-label">Units Consumed</label>
        <input asp-for="UnitsConsumed" type="number" step="1" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Calculate Bill</button>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="alert alert-danger mt-3" role="alert">@Model.ErrorMessage</p>
}
@if (Model.BillAmount.HasValue)
{
    <div class="card mt-3 col-md-4">
        <div class="card-body">
            <h2 class="h5 card-title">Bill Summary</h2>
            <p class="mb-1">Customer: @Model.CustomerName</p>
            <p class="mb-1">Meter Number: @Model.MeterNumber</p>
            <p class="mb-1">Units Consumed: @Model.UnitsConsumed</p>
            <p class="mb-0 fw-bold">Bill Amount: ₹@Model.BillAmount.Value.ToString("0.00")</p>
        </div>
    </div>
}
