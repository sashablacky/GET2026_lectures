@page
@model EmployeeRegistrationModel
@{
    ViewData["Title"] = "Employee Registration";
}

<h1>Employee Registration</h1>

<form method="post" class="col-md-4">
    <div class="mb-2">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Salary" class="form-label"></label>
        <input asp-for="Salary" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
        <p class="mb-0">@Model.Message</p>
        @if (Model.IsSuccess)
        {
            <ul class="mb-0 mt-2">
                <li>Email: @Model.Email</li>
                <li>Phone: @Model.Phone</li>
                <li>Department: @Model.Department</li>
                <li>Salary: @Model.Salary</li>
            </ul>
        }
    </div>
}
