@page
@model StudentDetailsModel
@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>
<table class="table w-auto">
    <tr><th>Id</th><td>@Model.Id</td></tr>
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Course</th><td>@Model.Course</td></tr>
    <tr><th>Age</th><td>@Model.Age</td></tr>
    <tr><th>College</th><td>@Model.College</td></tr>
</table>

@if (Model.Age < 25)
{
    <p class="alert alert-info">This student is below 25 years old.</p>
}
else
{
    <p class="alert alert-secondary">This student is 25 years old or older.</p>
}
